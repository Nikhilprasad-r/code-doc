# Copy to .env and fill in. Both keys are optional for a first run:
# without VOYAGE_API_KEY indexing uses an offline hashing embedder (keyword search still works),
# without ANTHROPIC_API_KEY indexing and search work but chat returns an error.

ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Agent model. claude-opus-5-5 is the default; claude-sonnet-5-5 is cheaper and faster;
# claude-haiku-5-5 is about 40x cheaper than Opus (the demo screenshots use it).
AGENT_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
AGENT_EFFORT=medium

# Voyage models
EMBED_MODEL=voyage-code-3
EMBED_DIM=1024
RERANK_MODEL=rerank-2.5

# Observability (see README "Observability"). json logs suit Docker; text is easier to read locally.
LOG_FORMAT=json
LOG_LEVEL=INFO
# Store each question and answer in answer_runs (metrics are recorded either way).
RECORD_ANSWER_TEXT=true
# Tracing is off unless this is set. docker-compose.observability.yml sets it for the containers;
# for a backend run outside Docker, with that file's Jaeger running:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
